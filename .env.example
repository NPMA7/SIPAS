# Database Configuration
DB_NAME=hotspot_db
DB_USER=hotspot_user
DB_PASSWORD=your_secure_password_here
DB_HOST=postgres
DB_PORT=5432

# JWT Authentication
# Ganti dengan string acak yang panjang dan aman pada saat produksi (production)
JWT_SECRET=your_jwt_secret_key_here

# Application Settings
NODE_ENV=production
PORT=3001

# Network & Server Host IP
# IP Public VPS tempat Docker backend & frontend Nginx dijalankan
SERVER_IP=103.67.244.193
SERVER_PORT=3000

# SSO Configuration (mock / real)
SSO_MODE=mock
SSO_MOCK_URL=http://localhost:3001/api/sso-mock/login
SSO_REAL_URL=https://xxxxxxx/api/login

