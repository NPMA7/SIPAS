# Database Configuration
DB_NAME=hotspot_db
DB_USER=hotspot_user
DB_PASSWORD=your_secure_password_here
DB_HOST=postgres
DB_PORT=5432

# JWT Authentication
# Ganti dengan string acak yang panjang dan aman pada saat produksi (production)
JWT_SECRET=your_jwt_secret_key_here

# Application Settings
NODE_ENV=production
PORT=3001

# Public Domain Settings
SERVER_IP=sipas.npma.my.id                # Domain Cloudflare Tunnel Anda
SERVER_PORT=443                           # Port HTTPS standar Cloudflare

# SSO Configuration (mock / real)
SSO_MODE=mock
SSO_MOCK_URL=http://localhost:3001/api/sso-mock/login
SSO_REAL_URL=https://xxxxxxx/api/login

